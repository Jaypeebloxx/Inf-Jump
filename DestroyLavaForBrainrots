-- AUTO COLLECT CASH (RENAMED)
getgenv().AutoCollect = false

Tab:CreateToggle({
    Name = "Auto Collect Cash",
    CurrentValue = false,
    Callback = function(Value)
        getgenv().AutoCollect = Value
    end
})

task.spawn(function()
    local remote = game:GetService("ReplicatedStorage").Remotes.CollectPedestalCash

    while true do
        task.wait(0.3)

        if getgenv().AutoCollect then
            pcall(function()
                for _, base in pairs(workspace.Bases:GetChildren()) do
                    for _, pedestal in pairs(base:GetChildren()) do
                        if pedestal.Name:find("Pedestal") then
                            remote:FireServer(pedestal)
                        end
                    end
                end
            end)
        end
    end
end)

