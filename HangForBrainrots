-- BUY SPEED
Tab:CreateButton({
    Name = "Buy Speed",
    Callback = function()
        buySpeed:FireServer(1)
    end
})

-- AUTO SPEED
getgenv().AutoSpeed = false
Tab:CreateToggle({
    Name = "Auto Buy Speed",
    CurrentValue = false,
    Callback = function(Value)
        getgenv().AutoSpeed = Value
        while getgenv().AutoSpeed do
            pcall(function()
                buySpeed:FireServer(1)
            end)
            task.wait(1)
        end
    end
})

-- AUTO REBIRTH
getgenv().AutoRebirth = false
Tab:CreateToggle({
    Name = "Auto Rebirth",
    CurrentValue = false,
    Callback = function(Value)
        getgenv().AutoRebirth = Value
        while getgenv().AutoRebirth do
            pcall(function()
                rebirthRemote:FireServer()
            end)
            task.wait(2)
        end
    end
})
