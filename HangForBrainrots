-- LOAD RAYFIELD
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "HangForBrainrot",
    LoadingTitle = "Loading...",
    LoadingSubtitle = "by Jaypeeblox",
    ConfigurationSaving = {
        Enabled = false
    }
})

local Tab = Window:CreateTab("Main", 4483362458)

-- REMOTES
local buySpeed = game:GetService("ReplicatedStorage").Remotes.BuySpeed
local rebirthRemote = game:GetService("ReplicatedStorage").Remotes.RebirthRequest

-- TP TO SPAWN
