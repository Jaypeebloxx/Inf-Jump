})

-- TP TO CELESTIAL
Tab:CreateButton({
    Name = "TP to Celestial Area",
    Callback = function()
        game.Players.LocalPlayer.Character:WaitForChild("HumanoidRootPart").CFrame = CFrame.new(
            8593.46875, 29.0040703, -19.5712185,
